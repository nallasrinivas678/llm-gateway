{
  "name": "assistant-node",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.evals.json",
    "eval": "tsx --env-file=.env evals/run.ts",
    "eval:agent": "tsx --env-file=.env evals/agent/run.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@langchain/core": "^1.5.0",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "langchain": "^1.6.7",
    "pg": "^8.23.1",
    "unpdf": "2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
