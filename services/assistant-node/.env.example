# Copy to .env and fill in. Never commit .env, and never paste its values into chat or tickets.
# Production values go onto Fly with: ./scripts/set-fly-secrets.ps1 -App <fly-app-name>

# --- Login token checks (needed now) ---
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# --- Needed from Phase 2b: reading and refreshing each user's Google token ---
# Server-side Postgres connection (Supabase > Project Settings > Database > Connection string).
# Use the POOLER string (Connect > Transaction pooler), host like aws-0-<region>.pooler.supabase.com.
# Do not use the direct host db.<ref>.supabase.co: it is IPv6-only and often does not resolve.
# User: assistant_tokens.<project-ref> (the narrow role from the google_tokens migration), not postgres.
# This connection bypasses row-level security, so the code only ever touches the google_tokens
# table with it, always filtered by the signed-in user's id.
SUPABASE_DB_URL=postgresql://assistant_tokens.<project-ref>:<password>@<pooler-host>:6543/postgres
# Same OAuth client the .NET gateway uses (GoogleOAuth:ClientId / ClientSecret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Connect Google (needed for GET /auth/google/start and POST /auth/google/exchange) ---
# A page of the web app that Google sends the browser back to, and that is also listed under
# "Authorized redirect URIs" for the OAuth client in the Google Cloud console.
# GOOGLE_REDIRECT_URI=https://tasktide.app/app/google/callback

# --- Chat (needed for POST /assistant/chat) ---
# Public values: safe to share, the web app ships the same key (Supabase > Project Settings > API Keys).
SUPABASE_ANON_KEY=
# Optional: defaults to the host of SUPABASE_JWT_ISSUER.
# SUPABASE_URL=https://<project-ref>.supabase.co

# --- Gemini (chat now; embeddings, summaries and PDF Q&A later) --- ---
GOOGLE_API_KEY=
